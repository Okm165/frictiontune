# Copy to .env and fill in. Nothing here is required by default; the config tree
# expands these variables at load time. Unset variables keep their defaults, so
# the repo carries no host, path, or model id of its own.

# --- corpus ---------------------------------------------------------------
# Path to the SQLite session database to mine (opened read-only).
FRICTIONTUNE_CORPUS_DB=/path/to/opencode.db

# --- base model -----------------------------------------------------------
# Local directory holding the bf16 HF checkpoint (preferred), or a repo id if
# you allow downloads. Training needs a bf16 checkpoint, not a GGUF.
FRICTIONTUNE_BASE_WEIGHTS=/models/your-base-model
FRICTIONTUNE_BASE_REPO=your-org/your-base-model
FRICTIONTUNE_TOKENIZER=/models/your-base-model

# --- LLM endpoints (OpenAI-compatible) ------------------------------------
# The analyst/judge/teacher side. Any OpenAI-compatible server works.
FRICTIONTUNE_LLM_BASE_URL=http://localhost:8000/v1
FRICTIONTUNE_LLM_API_KEY=sk-local
FRICTIONTUNE_MODEL=your-analyst-model
FRICTIONTUNE_TEACHER_MODEL=your-teacher-model
FRICTIONTUNE_USER_SIM_MODEL=your-teacher-model

# The model under evaluation: the base endpoint and the tuned adapter endpoint.
FRICTIONTUNE_TARGET_BASE_URL=http://localhost:8080/v1
FRICTIONTUNE_TARGET_MODEL=your-target-model
FRICTIONTUNE_TARGET_API_KEY=
FRICTIONTUNE_ADAPTER_BASE_URL=http://localhost:8081/v1
FRICTIONTUNE_ADAPTER_MODEL=your-target-model

# --- embeddings -----------------------------------------------------------
# Used for retrieval only (candidate neighbours an agent then judges).
FRICTIONTUNE_EMBED_BASE_URL=http://localhost:8000/v1
FRICTIONTUNE_EMBED_MODEL=text-embedding-3-small
FRICTIONTUNE_EMBED_API_KEY=

# --- optional backends ----------------------------------------------------
# External agent runner used by the `rollout` extension (ACP/HTTP).
FRICTIONTUNE_ROLLOUT_URL=
FRICTIONTUNE_ROLLOUT_TOKEN=
# Optional remote judge used as a GRPO reward term.
FRICTIONTUNE_GRPO_JUDGE_URL=
# Copy to .env and fill in. Nothing here is required by default; the config tree
# expands these variables at load time. Unset variables keep their defaults.

# --- corpus ---------------------------------------------------------------
# Path to the SQLite session database to mine (read-only).
FRICTIONTUNE_CORPUS_DB=/path/to/opencode.db

# --- base model -----------------------------------------------------------
# Local directory holding the bf16 HF checkpoint (preferred), or a repo id if
# you allow downloads.
FRICTIONTUNE_BASE_WEIGHTS=/models/Qwen2.5-7B-Instruct
FRICTIONTUNE_BASE_REPO=Qwen/Qwen2.5-7B-Instruct
FRICTIONTUNE_TOKENIZER=/models/Qwen2.5-7B-Instruct

# --- LLM endpoints (OpenAI-compatible) ------------------------------------
FRICTIONTUNE_LLM_BASE_URL=http://localhost:8000/v1
FRICTIONTUNE_LLM_API_KEY=sk-local
FRICTIONTUNE_MODEL=gpt-4o-mini
FRICTIONTUNE_TEACHER_MODEL=gpt-4o
FRICTIONTUNE_USER_SIM_MODEL=gpt-4o

# The model under evaluation (base) and the tuned endpoint.
FRICTIONTUNE_TARGET_BASE_URL=http://localhost:30080/v1
FRICTIONTUNE_TARGET_MODEL=qwen3.8-flash-next
FRICTIONTUNE_TARGET_API_KEY=
FRICTIONTUNE_ADAPTER_BASE_URL=http://localhost:30081/v1
FRICTIONTUNE_ADAPTER_MODEL=qwen3.8-flash-next

# --- embeddings -----------------------------------------------------------
FRICTIONTUNE_EMBED_BASE_URL=http://localhost:8000/v1
FRICTIONTUNE_EMBED_MODEL=text-embedding-3-small
FRICTIONTUNE_EMBED_API_KEY=

# --- optional backends ----------------------------------------------------
# External agent runner used by the `rollout` extension (ACP/HTTP).
FRICTIONTUNE_ROLLOUT_URL=
FRICTIONTUNE_ROLLOUT_TOKEN=
# Optional remote judge used as a GRPO reward term.
FRICTIONTUNE_GRPO_JUDGE_URL=
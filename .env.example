# Copy to .env and fill in. Nothing here is required by default; the config tree
# expands these variables at load time. Unset variables keep their defaults, so
# the repo carries no host, path, or model id of its own.

# --- corpus ---------------------------------------------------------------
# Path to the SQLite session database to mine (opened read-only).
FRICTIONTUNE_CORPUS_DB=/path/to/opencode.db

# --- base model -----------------------------------------------------------
# Local directory holding the bf16 HF checkpoint (preferred), or a repo id if
# you allow downloads. Training needs a bf16 checkpoint, not a GGUF.
FRICTIONTUNE_BASE_WEIGHTS=/models/your-base-model
FRICTIONTUNE_BASE_REPO=your-org/your-base-model
FRICTIONTUNE_ALLOW_DOWNLOAD=false
FRICTIONTUNE_TOKENIZER=/models/your-base-model

# --- LLM endpoints (OpenAI-compatible) ------------------------------------
# The analyst/judge/teacher side. Any OpenAI-compatible server works.
FRICTIONTUNE_LLM_BASE_URL=http://localhost:8000/v1
FRICTIONTUNE_LLM_API_KEY=sk-local
FRICTIONTUNE_MODEL=your-analyst-model
FRICTIONTUNE_TEACHER_MODEL=your-teacher-model
FRICTIONTUNE_USER_SIM_MODEL=your-teacher-model

# --- local llama.cpp server (the container `llm` image) --------------------
# Fully-local alternative to a hosted endpoint. `scripts/ops/ft_pod.sh` with
# FT_LOCAL_LLM=1 runs `frictiontune:llm` and points the `local` environment
# overlay (configs/environments/local.yaml) at it — every judgement, generation,
# and compaction role then runs on the GPUs. These configure the server itself.
#
# CTX is the *total* context, divided across PARALLEL slots (CTX/PARALLEL each).
# A Qwen3-8B token costs ~144 KiB of KV, so 262144 tokens (~36 GiB) needs the
# model layer-split across all the cards; that is the default in ft_pod.sh's
# data phase. Lower both together on one card.
FRICTIONTUNE_LLM_MODEL_PATH=/work/.toolchain/models/Qwen3-8B-Q4_K_M.gguf
FRICTIONTUNE_LLM_ALIAS=qwen3-8b
FRICTIONTUNE_LLM_PORT=8000
FRICTIONTUNE_LLM_CTX=262144
FRICTIONTUNE_LLM_NGL=999
FRICTIONTUNE_LLM_PARALLEL=8
FRICTIONTUNE_LLM_REASONING=off
# FRICTIONTUNE_LLM_SPLIT_MODE=layer   # layer (no NVLink) | row
# FRICTIONTUNE_LLM_TENSOR_SPLIT=1,1,1 # explicit per-GPU weight split
# FRICTIONTUNE_LLM_THREADS=64         # CPU sampling pool (default: nproc)
# The local overlay reads this to find the server and to size its concurrency:
# FRICTIONTUNE_LOCAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
# FRICTIONTUNE_LOCAL_LLM_MODEL=qwen3-8b
# FRICTIONTUNE_LOCAL_LLM_CONCURRENCY=8

# The model under evaluation: the base endpoint and the tuned adapter endpoint.
FRICTIONTUNE_TARGET_BASE_URL=http://localhost:8080/v1
FRICTIONTUNE_TARGET_MODEL=your-target-model
FRICTIONTUNE_TARGET_API_KEY=
FRICTIONTUNE_ADAPTER_BASE_URL=http://localhost:8081/v1
FRICTIONTUNE_ADAPTER_MODEL=your-target-model

# --- embeddings -----------------------------------------------------------
# Used for retrieval only (candidate neighbours an agent then judges).
FRICTIONTUNE_EMBED_BASE_URL=http://localhost:8000/v1
FRICTIONTUNE_EMBED_MODEL=text-embedding-3-small
FRICTIONTUNE_EMBED_API_KEY=
# Per-text character cap sent to the embedder (defaults to 8000, safely under
# an ~8192-token context). Raise it only for a corpus you know is low-density.
FRICTIONTUNE_EMBED_MAX_INPUT_CHARS=8000
#
# Local embedder (same `llm` image, FRICTIONTUNE_LLM_MODE=embed): a bge-m3 GGUF
# served at /v1/embeddings, so T3/T4 retrieval and dedup never leave the box.
# `ft_pod.sh data` with FT_LOCAL_LLM=1 starts it on GPU0:8001 and points
# FRICTIONTUNE_EMBED_* here automatically; for a hand-rolled run, uncomment:
# scripts/ops/fetch_gguf.sh bge-m3
# FRICTIONTUNE_EMBED_MODEL_PATH=/work/.toolchain/models/bge-m3-Q8_0.gguf
# FRICTIONTUNE_EMBED_ALIAS=bge-m3
# FRICTIONTUNE_EMBED_BASE_URL=http://127.0.0.1:8001/v1
# FRICTIONTUNE_EMBED_MODEL=bge-m3
# FRICTIONTUNE_EMBED_API_KEY=sk-local

# --- optional backends ----------------------------------------------------
# External agent runner used by the `rollout` extension (ACP/HTTP).
FRICTIONTUNE_ROLLOUT_URL=
FRICTIONTUNE_ROLLOUT_TOKEN=
# Optional remote judge used as a GRPO reward term.
FRICTIONTUNE_GRPO_JUDGE_URL=